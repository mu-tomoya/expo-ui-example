{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "description": "Group Expo packages",
      "groupName": "Expo packages",
      "matchManagers": ["bun"],
      "matchPackageNames": ["expo", "/^expo-/", "/^@expo\\//"]
    },
    {
      "description": "Group React Native packages",
      "groupName": "React Native packages",
      "matchManagers": ["bun"],
      "matchPackageNames": [
        "react-native",
        "/^react-native-/",
        "/^@react-native\\//"
      ]
    },
    {
      "description": "Ignore major Bun dependency updates",
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
